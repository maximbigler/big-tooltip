{
  "name": "@maximbigler/big-tooltip-core",
  "version": "0.2.0",
  "description": "Framework-agnostic tooltip engine",
  "homepage": "https://github.com/maximbigler/big-tooltip#readme",
  "bugs": {
    "url": "https://github.com/maximbigler/big-tooltip/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximbigler/big-tooltip.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
